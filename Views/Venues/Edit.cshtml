@{
}

@model Event_Ease.Models.ViewModels.AddVenueViewModel

<h1>Edit Venue</h1>

@if(Model is null)
{
    <p>
        No venue was found with this ID 
    </p>
}
else{

    <div style="display: flex; font-family: Arial, sans-serif; margin: 20px; gap: 20px; background: #f9f9f9; border-radius: 10px; padding: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
        <div style="flex: 2; padding-left: 50px;">

            <h2 style="color: #333;">Edit Venue Details</h2>
            <form method="post" enctype="multipart/form-data">
                <!-- Venue ID (hidden) -->
                <input type="hidden" asp-for="VenueID" />

                <!-- Venue Name -->
                <div class="mt-3">
                    <label class="form-label">Venue Name</label>
                    <input type="text" class="form-control" asp-for="VenueName" required maxlength="100" />
                    <span asp-validation-for="VenueName" class="text-danger"></span>
                </div>

                <!-- Venue Location -->
                <div class="mt-3">
                    <label class="form-label">Venue Location</label>
                    <input type="text" class="form-control" asp-for="Location" required maxlength="100" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <!-- Venue Capacity -->
                <div class="mt-3">
                    <label class="form-label">Venue Capacity</label>
                    <input type="number" class="form-control" asp-for="Capacity" required min="1" max="10000" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>

                <!-- Venue Image -->
                <div class="mt-3">
                    <label class="form-label" for="ImageFile">Venue Image</label>
                    <!-- File input for image upload -->
                    <input type="file" class="form-control" asp-for="ImageFile" />
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <!-- Venue Description -->
                <div class="mt-3">
                    <label class="form-label">Venue Description</label>
                    <input type="text" class="form-control" asp-for="Description" required maxlength="500" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Is Active Checkbox -->
                <div class="mt-3">
                    <input type="checkbox" id="Active" class="form-check-input" asp-for="IsActive" />
                    <label class="form-check-label" for="Active">Is Active</label>
                </div>

                <!-- Submit Button -->
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>

        <!-- Image Section -->
        <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;">
            <span style="font-size: 18px; font-weight: bold; color: #555; margin-bottom: 10px;">Venue Image</span>

            <!-- Display the current image or fallback message -->
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img id="imagePreview" src="@Model.ImageUrl" alt="Current Venue Image" style="max-width: 100%; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
            }
            else
            {
                <p>No image available.</p>
            }
        </div>
    </div>
}